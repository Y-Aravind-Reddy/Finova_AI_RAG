# ---- Copy to .env and fill in. Never commit .env. ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
AUTH_MODE=supabase
ALLOW_DEMO_AUTH=false

# ---- Optional settings (defaults shown) ----
# production | development | test. Demo auth is impossible when production (the default).
APP_ENV=production
# Comma-separated list of allowed browser origins for the React frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Minimum cosine relevance (0-1) for a chunk to be used; 0 disables.
RETRIEVAL_SCORE_THRESHOLD=0.0
LLM_TEMPERATURE=0.0
MAX_QUESTION_CHARS=2000
SUPABASE_PROFILES_TABLE=profiles
# Must match vector(N) in supabase/migrations/*_policy_vector_store.sql.
EMBEDDING_DIMENSIONS=3072
# Regex for frontend origins that change (e.g. Google AI Studio / Cloud Run). Must be ^anchored$.
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.(run\.app|usercontent\.goog)$
# Bound LLM calls so a provider outage returns 502 quickly instead of hanging /chat.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Optional second LLM provider used when the primary fails (must differ from LLM_PROVIDER).
# LLM_FALLBACK_PROVIDER=groq
